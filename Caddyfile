# Vesper Caddyfile — serves the static Next.js export, proxies /api to the
# backend, and serves the Quartz Second Brain at /brain. All traffic stays on
# the private Tailscale tailnet: set VESPER_DOMAIN to your `*.ts.net` hostname
# (or any private host) in .env; Caddy auto-provisions certs for public ones.

{$VESPER_DOMAIN:localhost} {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}

	# API — reverse-proxied to the FastAPI container, same-origin.
	handle /api/* {
		reverse_proxy vesper-api:8000
	}
	handle /health {
		reverse_proxy vesper-api:8000
	}

	# Quartz Second Brain — static site, private.
	handle_path /brain/* {
		root * /srv/brain
		try_files {path} {path}.html {path}/ =404
		file_server
	}

	# Next static assets must never fall through to the SPA HTML fallback. A
	# stale HTML page should produce a normal asset 404, not an HTML stylesheet
	# response that the browser rejects with strict MIME checking.
	handle /_next/static/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Web app (static export).
	handle {
		root * /srv
		@html path *.html
		header @html Cache-Control "no-store"
		try_files {path} {path}/ /index.html
		file_server
	}
}
