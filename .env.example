# Vesper — copy to .env (start.sh does this automatically) and fill real values.
# start.sh generates POSTGRES_PASSWORD/JWT_SECRET; you provide the API key,
# Telegram token/user, and optionally the vault-backup GitHub creds.

# ── App ────────────────────────────────────────────────────────────────────
# App mode: api | worker (switched by vesper-api / vesper-worker services)
APP_MODE=api
PORT=8000

# ── Postgres ───────────────────────────────────────────────────────────────
# Password generated by start.sh on first run. DATABASE_URL uses the
# in-network `postgres` host for Docker services (env_file); host-run Hermes
# MCP servers fall back to db.py's localhost default (never overridden here).
POSTGRES_USER=vesper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vesper
DATABASE_URL=postgresql+asyncpg://vesper:change-me@postgres:5432/vesper

# ── Redis ──────────────────────────────────────────────────────────────────
# In-network URL for Docker services (env_file). Host-run Hermes MCP servers
# fall back to bus.py's localhost default — redis is published on
# 127.0.0.1:6379 by docker-compose, so both sides reach the same bus.
REDIS_URL=redis://redis:6379/0

# ── Web app ────────────────────────────────────────────────────────────────
# JWT for the dashboard (generated by start.sh on first run)
JWT_SECRET=change-me

# ── Hermes Agent provider keys ─────────────────────────────────────────────
# OpenCode Go API key (hy3 primary, gpt-5.6-luna fallback — plan.md §14).
OPENCODE_GO_API_KEY=

# ── Telegram (notifications: graph pass, deadline, reminders) ─────────────
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID — the allowlist/recipient for notifications.
TELEGRAM_ALLOWED_USERS=
# Optional: a dedicated group/channel chat ID for notifications; falls back to
# TELEGRAM_ALLOWED_USERS when unset.
TELEGRAM_HOME_CHANNEL=

# ── Obsidian vault ─────────────────────────────────────────────────────────
# start.sh resolves this to an absolute path (HERMES_VAULT_PATH_ABS) and
# bind-mounts it into the worker/api so DB vault_path rows (written by host
# MCP servers and container jobs) stay consistent.
HERMES_VAULT_PATH=~/Documents/KnowledgeVault
# Hermes Agent's own SQLite store (mirrored by the hermes_mirror job).
HERMES_STATE_DB=~/.hermes/state.db

# ── Vault backup to a private GitHub repo (addendum §7) — optional ───────
GH_PAT=
VAULT_REPO_URL=
# Optional: full git remote URL (takes precedence over VAULT_REPO_URL+GH_PAT).
VAULT_GIT_REMOTE=

# ── Quartz digital-garden site (addendum §7) — optional ───────────────────
# The vault is built into a private static site by the `vesper-quartz`
# container (no Node needed here). Caddy serves it at /brain; the worker
# triggers a rebuild through this URL after each git push. Set BASE_URL to the
# private hostname Caddy serves the garden under (no protocol / slashes).
QUARTZ_TRIGGER_URL=http://vesper-quartz:8081/rebuild
QUARTZ_BASE_URL=brain.local

# ── Caddy / hosting (docker-compose) ──────────────────────────────────────
# Public hostname for the tailnet site (e.g. vesper.tailXXXX.ts.net). Caddy
# serves the web app, the /api proxy and the Quartz garden here.
VESPER_DOMAIN=localhost

# ── RSS ingestion (plan.md §12) — optional, comma-separated feed URLs ─────
RSS_FEEDS=
