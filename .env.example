# Vesper — copy to .env (start.sh does this automatically on first run) and
# fill real values. start.sh asks you for exactly three things:
#   - OpenCode Go API key (the brain's LLM)
#   - Telegram bot token (the agent's interface)
#   - Your numeric Telegram user ID (the allowlist — only you can talk to it)
# Everything else is generated (POSTGRES_PASSWORD, JWT_SECRET) or optional.

# ── App ────────────────────────────────────────────────────────────────────
# App mode: api | worker (switched by vesper-api / vesper-worker processes)
APP_MODE=api
PORT=8000

# ── Postgres (start.sh generates the password on first run) ────────────────
POSTGRES_USER=vesper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vesper
DATABASE_URL=postgresql+asyncpg://vesper:change-me@postgres:5432/vesper

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Web app ────────────────────────────────────────────────────────────────
# JWT for the dashboard (generated by start.sh on first run)
JWT_SECRET=change-me

# ── Hermes Agent provider keys ─────────────────────────────────────────────
# OpenCode Go API key (hy3 primary, gpt-5.6-luna fallback — plan.md §14).
# REQUIRED — this is the brain's model.
OPENCODE_GO_API_KEY=
# Optional fallback provider key (Hermes falls back to local Ollama otherwise).
GROQ_API_KEY=

# ── Telegram (the agent's primary interface) ───────────────────────────────
# REQUIRED. The bot token from @BotFather, and your numeric user ID (get it
# from @userinfobot). The bot only replies to TELEGRAM_ALLOWED_USERS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# Optional: a dedicated group/channel chat ID for notifications; falls back to
# TELEGRAM_ALLOWED_USERS when unset.
TELEGRAM_HOME_CHANNEL=

# ── Obsidian vault (created fresh by start.sh if missing) ─────────────────
HERMES_VAULT_PATH=~/Documents/KnowledgeVault
# start.sh resolves this to an absolute path (HERMES_VAULT_PATH_ABS).
HERMES_VAULT_PATH_ABS=
# Hermes Agent's own SQLite store (mirrored by the hermes_mirror job).
HERMES_STATE_DB=~/.hermes/state.db

# ── Vault backup to a private GitHub repo (addendum §7) — optional ───────
GH_PAT=
VAULT_REPO_URL=
# Optional: full git remote URL (takes precedence over VAULT_REPO_URL+GH_PAT).
VAULT_GIT_REMOTE=

# ── Quartz digital-garden site (addendum §7) — optional ───────────────────
QUARTZ_TRIGGER_URL=http://vesper-quartz:8081/rebuild
QUARTZ_BASE_URL=brain.local

# ── Caddy / hosting ────────────────────────────────────────────────────────
# Public hostname for the site (e.g. yourdomain.com). Leave empty for a
# localhost-only HTTP site. Set this for public HTTPS via Caddy.
VESPER_DOMAIN=
# Required when exposing the frontend publicly. start.sh generates a strong
# password if this is blank.
VESPER_BASIC_AUTH_USER=vesper
VESPER_BASIC_AUTH_PASSWORD=

# ── RSS ingestion (plan.md §12) — optional, comma-separated feed URLs ─────
RSS_FEEDS=

# ── Catalyst Swing Trader LLM (Part E) — uses OpenCode Go (same subscription) ─
# The catalyst_llm job at 18:40 IST runs `gpt-5.6-luna` against the screen's
# top candidates to produce a grounded catalyst signal (positive/negative/neutral
# with confidence). Falls back to OPENCODE_GO_API_KEY; degrades honestly to
# signal=none when the key is missing (never fabricates a verdict).
CATALYST_LLM_BASE_URL=https://opencode.ai/zen/go/v1
CATALYST_LLM_API_KEY=
CATALYST_LLM_MODEL=gpt-5.6-luna
CATALYST_TRADER_MAX_LLM_CALLS_PER_DAY=65
