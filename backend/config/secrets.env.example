# Vesper secrets — copy to secrets.env and fill in real values.
# Never commit real secrets.

# Postgres
POSTGRES_USER=vesper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vesper

# Redis
REDIS_URL=redis://redis:6379/0

# Web app JWT (reuse ProjectVesper SECRET_KEY pattern)
JWT_SECRET=change-me

# Hermes Agent provider (Phase 3)
OPENCODE_GO_API_KEY=
GROQ_API_KEY=

# Telegram (Phase 5) — Hermes Agent gateway
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Obsidian vault path (Journal/Knowledge)
HERMES_VAULT_PATH=~/Documents/KnowledgeVault
